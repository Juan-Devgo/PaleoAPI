{
  "db_name": "PostgreSQL",
  "query": "SELECT sp.species_id, p.id, p.name, e.id AS era_id, e.name AS era_name FROM unnest($1::text[]) AS u(id) CROSS JOIN LATERAL (SELECT l.species_id, l.period_id FROM species_periods l WHERE l.species_id = u.id OFFSET 0) sp JOIN periods p ON p.id = sp.period_id JOIN eras e ON e.id = p.era_id ORDER BY p.start_mya DESC, p.id",
