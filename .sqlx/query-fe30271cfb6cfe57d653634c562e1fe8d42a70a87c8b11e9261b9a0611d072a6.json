{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id AS species_id, d.id AS domain_id, d.name AS domain_name, k.id AS kingdom_id, k.name AS kingdom_name, p.id AS phylum_id, p.name AS phylum_name, c.id AS class_id, c.name AS class_name, o.id AS order_id, o.name AS order_name, f.id AS family_id, f.name AS family_name, g.id AS genus_id, g.name AS genus_name FROM species s JOIN genera g ON g.id = s.genus_id JOIN families f ON f.id = g.family_id JOIN orders o ON o.id = f.order_id JOIN classes c ON c.id = o.class_id JOIN phyla p ON p.id = c.phylum_id JOIN kingdoms k ON k.id = p.kingdom_id JOIN domains d ON d.id = k.domain_id WHERE s.id = ANY($1::text[])",
