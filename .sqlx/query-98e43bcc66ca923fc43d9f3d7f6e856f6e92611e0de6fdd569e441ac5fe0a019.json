  "query": "SELECT sc.species_id, c.id, c.name, c.type AS kind FROM species_continents sc JOIN continents c ON c.id = sc.continent_id WHERE sc.species_id = ANY($1::text[]) ORDER BY (c.type = 'modern'), lower(c.name) COLLATE paleo_name_sort, c.id",
