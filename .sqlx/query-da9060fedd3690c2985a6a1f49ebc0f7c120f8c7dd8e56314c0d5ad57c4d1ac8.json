  "query": "SELECT sp.species_id, p.id, p.name, e.id AS era_id, e.name AS era_name FROM species_periods sp JOIN periods p ON p.id = sp.period_id JOIN eras e ON e.id = p.era_id WHERE sp.species_id = ANY($1::text[]) ORDER BY p.start_mya DESC, p.id",
