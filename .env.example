# Copy to .env and replace every "change-me" placeholder. Never commit .env.
# Export into your shell with: set -a; . ./.env; set +a

# compose `db` service
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me
POSTGRES_PORT=5432

# API and `sqlx migrate` (development database)
DATABASE_URL=postgres://paleo:change-me@localhost:5432/change-me

# Test harness master database: the `postgres` maintenance DB, NEVER the development DB.
# Run tests with: DATABASE_URL="$TEST_DATABASE_URL" cargo test
TEST_DATABASE_URL=postgres://paleo:change-me@localhost:5432/postgres
